# Certim 服务端 systemd 单元（示例）。
#
# 安装：
#   sudo install -m 0644 systemd/certim.service /etc/systemd/system/certim.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now certim
#
# 单元创建并管理 /run/certim（RuntimeDirectory）和 /var/lib/certim
# （StateDirectory）。YAML 配置位于 /etc/certim/config.yaml；该文件缺失时，
# certim serve 会在首次启动时生成一份带完整说明的模板。

[Unit]
Description=Certim TLS certificate management server
Documentation=https://github.com/Aceak/Certim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际安装路径调整。
ExecStart=/usr/local/bin/certim serve /etc/certim/config.yaml
Restart=on-failure
RestartSec=5

User=root
Group=root

# 服务端写入 SQLite、不可变证书发布和 .credentials，其余保持只读。
StateDirectory=certim
RuntimeDirectory=certim
RuntimeDirectoryMode=0750
ReadWritePaths=/etc/certim

# 安全加固。仅当特定部署需要时才放宽。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=certim

[Install]
WantedBy=multi-user.target
